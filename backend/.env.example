# ============================================================================
# VeriCart AI — Backend Environment Configuration
# Copy this file to `.env` and fill in your real keys (the backend reads these
# via application.yml placeholders, e.g. ${KIMI_API_KEY}).
# Keys are NOT committed to git. Keep your real .env private.
# ============================================================================

# --- AI Mock mode -----------------------------------------------------------
# true  = simulated AI responses, no real API calls (default for local/demo)
# false = use the real LLM providers below for every AI feature
AI_MOCK_ENABLED=true

# --- Kimi (Moonshot) via Tencent Cloud TokenHub (INTERNATIONAL) -----------------
# All three providers below are served from the same TokenHub gateway. A single
# TokenHub key works for kimi-k3, hy4-preview, and deepseek-v4-pro-0813.
# Gateway endpoint: https://tokenhub-intl.tencentcloudmaas.com/v1/chat/completions
KIMI_API_KEY=YOUR_TOKENHUB_API_KEY
KIMI_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
KIMI_MODEL=kimi-k3

# --- DeepSeek via Tencent Cloud TokenHub (INTERNATIONAL) ------------------------
# Used for trust scoring + fake-review detection, and as chat fallback.
# NOTE: the DeepSeek client appends "/v1/chat/completions", so base-url omits "/v1".
DEEPSEEK_API_KEY=YOUR_TOKENHUB_API_KEY
DEEPSEEK_ALT_API_KEY=YOUR_DEEPSEEK_ALT_API_KEY
DEEPSEEK_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com
DEEPSEEK_MODEL=deepseek-v4-pro-0813

# --- Hunyuan (Tencent) via Tencent Cloud TokenHub (INTERNATIONAL) -------------
# Review summarization. Client appends "/chat/completions".
HUNYUAN_API_KEY=YOUR_TOKENHUB_API_KEY
HUNYUAN_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
HUNYUAN_MODEL=hy4-preview
